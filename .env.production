# Spotify OAuth
SPOTIFY_CLIENT_ID=${SPOTIFY_CLIENT_ID}
SPOTIFY_CLIENT_SECRET=${SPOTIFY_CLIENT_SECRET}
SPOTIFY_REDIRECT_URI=https://spotify-analyzer.tailscale.io/api/auth/callback

# App
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database (persistent volume on Proxmox)
DB_PATH=/data/spotify.db

# Cache (6 hours)
CACHE_TTL_MINUTES=360

# Sync
SYNC_INTERVAL_HOURS=6
SYNC_ENABLED=true
