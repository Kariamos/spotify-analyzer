# ===========================
# SPOTIFY API
# ===========================
# Crea app su: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ===========================
# SERVER
# ===========================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ===========================
# DATABASE
# ===========================
# Per Proxmox: /data/spotify-analyzer/db.sqlite (persist volume)
DATABASE_PATH=./data/db.sqlite
DATABASE_BACKUP_PATH=./data/backups

# ===========================
# CRON JOBS
# ===========================
# Sincronizza ascolti ogni 6 ore
# Formato: cron expression (0 */6 * * *)
SYNC_SCHEDULE=0 */6 * * *

# Giorni di storia da sincronizzare per primo run
INITIAL_SYNC_DAYS=90

# ===========================
# CACHE
# ===========================
# TTL cache insights in ore
CACHE_TTL_HOURS=6

# ===========================
# LOGGING
# ===========================
LOG_LEVEL=info
LOG_FORMAT=json

# ===========================
# OPTIONAL: Tailscale / Reverse proxy
# ===========================
# Se esposti via Tailscale Funnel
TAILSCALE_HOSTNAME=spotify-analyzer.your-tailnet.ts.net
ENABLE_CORS=true
CORS_ORIGINS=https://your-ha-dashboard.ts.net,http://localhost:3000
