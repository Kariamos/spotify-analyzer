{
  "name": "spotify-analyzer",
  "version": "0.1.0",
  "description": "Spotify listening analysis with mood, key patterns, and taste evolution",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["spotify", "analysis", "mood", "music"],
  "author": "Marco Kariamos",
  "license": "MIT",
  "dependencies": {
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "sqlite3": "^5.1.7",
    "express": "^4.18.2",
    "node-cron": "^3.0.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/sqlite3": "^3.1.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
